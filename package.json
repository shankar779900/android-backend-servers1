{
  "name": "growup-investments-mobile",
  "private": true,
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "node scripts/build-web.js",
    "backend": "node backend/server.js",
    "worker": "node backend/workers/finalizeWorker.js",
    "test": "jest --runInBand",
    "test:backend:unit": "node --test backend/test/depositSettingsExpiry.test.js backend/test/depositVerification.test.js backend/test/investmentPlanAvailability.test.js backend/test/otpFlow.test.js backend/test/referralProgram.test.js backend/test/weeklyEarnings.test.js",
    "test:backend:integration": "node --test backend/test/claimEarnings.integration.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/backend/test/finalize.test.js"
    ],
    "verbose": true
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@prisma/client": "^5.21.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.0",
    "@sentry/node": "^10.69.0",
    "axios": "^1.5.0",
    "babel-preset-expo": "~54.0.10",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bullmq": "^1.49.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo": "^54.0.36",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.0",
    "prom-client": "^14.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "jest": "^29.7.0",
    "prisma": "^5.21.1",
    "typescript": "^5.5.4"
  }
}
